table fatti_magazzino
	lineageTag: 2bb87264-c2c0-4f6a-9242-db5c11fe0855

	measure 'Valore magazzino' =
			VAR ultima = CALCULATE ( MAX ( fatti_magazzino[data] ) )
			RETURN CALCULATE ( SUM ( fatti_magazzino[valore] ), dim_data[data] = ultima )
		formatString: #,0 €
		lineageTag: 2e9a6f6c-55f0-4795-9b32-b655a603123b

	measure 'Paia in magazzino' =
			VAR ultima = CALCULATE ( MAX ( fatti_magazzino[data] ) )
			RETURN CALCULATE ( SUM ( fatti_magazzino[giacenza] ), dim_data[data] = ultima )
		formatString: #,0
		lineageTag: fa629f35-31cc-4700-803e-8e8abc92b3eb

	measure 'Valore articoli fermi' = CALCULATE ( [Valore magazzino], dim_prodotto[fermo] = TRUE () )
		formatString: #,0 €
		lineageTag: 872d435a-2066-47ee-9563-24111d09a716

	measure '% magazzino fermo' = DIVIDE ( [Valore articoli fermi], [Valore magazzino] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c4d21045-d11d-4201-b86e-cbbe17ca041f

	measure 'Rotazione magazzino' = DIVIDE ( [Costo del venduto 12 mesi], [Valore magazzino] )
		formatString: 0.0
		lineageTag: 4999da81-07c7-4030-9d26-25b91023fae1

	column data
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 16f82636-5a4d-4da4-b3ec-180575bab205
		summarizeBy: none
		sourceColumn: data

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column prodotto_id
		dataType: int64
		formatString: 0
		lineageTag: d2a0e280-e9a2-4951-a4e8-9ce486964da3
		summarizeBy: none
		sourceColumn: prodotto_id

		annotation SummarizationSetBy = Automatic

	column giacenza
		dataType: int64
		formatString: #,0
		lineageTag: bc333de9-d147-4067-a798-be3f10123396
		summarizeBy: sum
		sourceColumn: giacenza

		annotation SummarizationSetBy = Automatic

	column valore
		dataType: double
		formatString: #,0 €
		lineageTag: 3aaadacf-247e-4975-a777-ddcd161c837b
		summarizeBy: sum
		sourceColumn: valore

		annotation SummarizationSetBy = Automatic

	partition fatti_magazzino = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "fatti_magazzino.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    Tipi = Table.TransformColumnTypes(Intestazioni, {{"data", type date}, {"prodotto_id", Int64.Type}, {"giacenza", Int64.Type}, {"valore", type number}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table

