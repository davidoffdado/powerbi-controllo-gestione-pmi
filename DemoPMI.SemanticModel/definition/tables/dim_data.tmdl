	partition dim_data = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "dim_data.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    Tipi = Table.TransformColumnTypes(Intestazioni, {{"data", type date}, {"anno", Int64.Type}, {"mese_numero", Int64.Type}, {"mese", type date}, {"mese_nome", type text}, {"trimestre", type text}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table

