table fatti_scadenze
	lineageTag: deaabd7c-f3f0-42ba-8074-d336c6905f9b

	measure 'Crediti aperti' = CALCULATE ( SUM ( fatti_scadenze[importo] ), fatti_scadenze[stato] = "Aperta" )
		formatString: #,0 €
		lineageTag: e7eb6212-2b83-4315-931a-eff775b67337

	measure 'Crediti scaduti' =
			CALCULATE (
			    SUM ( fatti_scadenze[importo] ),
			    fatti_scadenze[stato] = "Aperta",
			    fatti_scadenze[fascia_ordine] >= 2
			)
		formatString: #,0 €
		lineageTag: 3470c1b5-ec7b-4015-87a0-155c5c026058

	measure '% scaduto' = DIVIDE ( [Crediti scaduti], [Crediti aperti] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 794c9907-8c47-4e29-8eec-df822d61215d

	measure 'Ritardo medio (giorni)' = AVERAGE ( fatti_scadenze[giorni_ritardo] )
		formatString: 0.0
		lineageTag: 64bfabed-6ea0-40fc-bd0a-4b6a04fb7550

	measure 'Giorni medi di incasso' = AVERAGE ( fatti_scadenze[giorni_incasso] )
		formatString: 0
		lineageTag: 21066383-d11c-4249-b2a3-256955f0ea84

	measure 'Colore ritardo' =
			SWITCH ( TRUE (),
			    [Ritardo medio (giorni)] > 30, "#B3473A",
			    [Ritardo medio (giorni)] <= 5, "#5E7D63",
			    "#2B2B2B"
			)
		lineageTag: 8485df1b-4ac0-4b3b-aec9-b4f8f68d46e6

