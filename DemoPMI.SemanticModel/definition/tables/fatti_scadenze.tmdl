	partition fatti_scadenze = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "fatti_scadenze.csv"), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    Tipi = Table.TransformColumnTypes(Intestazioni, {{"fattura", type text}, {"cliente_id", Int64.Type}, {"data_fattura", type date}, {"data_scadenza", type date}, {"data_incasso", type date}, {"importo", type number}, {"stato", type text}, {"fascia", type text}, {"fascia_ordine", Int64.Type}, {"giorni_ritardo", Int64.Type}, {"giorni_incasso", Int64.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table

